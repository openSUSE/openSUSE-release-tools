# Copy this file to /etc/default/osrt-obsrsync.env.<instance_name>
# where <instance_name> is the name of the unit instance

# API_URL: the Open Build Service apiurl
API_URL="https://api.suse.de"

# OPENQA_URL: the url of the local openQA instance
OPENQA_URL="https://openqa.suse.de"

# OSRT_NAMESPACES: the namespaces to look for
OSRT_NAMESPACES="SUSE:SLFO:"

# OSC_CONFIG: the path to the oscrc configuration file
# to use to interact with the Open Build Service
OSC_CONFIG="/etc/openSUSE-release-tools/oscrc.example"

# OPENQA_CONFIG: the path to the openQA configuration
# file to use to interact with openQA
OPENQA_CONFIG="/etc/openSUSE-release-tools/openQA.example"
